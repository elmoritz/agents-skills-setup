version=1
ticket_id.prefix=BHS
ticket_id.padding=3
ticket_id.start=1
lifecycle.stages.0.key=inbox
lifecycle.stages.0.label=Inbox
lifecycle.stages.0.roles.0=inbox
lifecycle.stages.0.filesystem.folder=inbox
lifecycle.stages.1.key=backlog
lifecycle.stages.1.label=Backlog
lifecycle.stages.1.roles.0=pickable
lifecycle.stages.1.filesystem.folder=backlog
lifecycle.stages.2.key=in-progress
lifecycle.stages.2.label=In progress
lifecycle.stages.2.roles.0=in_progress
lifecycle.stages.2.filesystem.folder=in-progress
lifecycle.stages.3.key=in-review
lifecycle.stages.3.label=In review
lifecycle.stages.3.roles.0=review
lifecycle.stages.3.filesystem.folder=in-review
lifecycle.stages.4.key=done
lifecycle.stages.4.label=Done
lifecycle.stages.4.roles.0=terminal
lifecycle.stages.4.filesystem.folder=done
backend.type=filesystem
backend.filesystem.root=docs/project
backend.filesystem.filename={id}-{slug}.md
backend.filesystem.transition=git_mv
backend.filesystem.commit_per_transition=true
types.feature.required_body_sections.0=why
types.feature.required_body_sections.1=acceptance_criteria
types.feature.required_body_sections.2=ux_surface
types.feature.required_body_sections.3=architecture_notes
types.feature.required_body_sections.4=research
types.feature.required_body_sections.5=out_of_scope
types.bug.required_body_sections.0=repro_steps
types.bug.required_body_sections.1=expected
types.bug.required_body_sections.2=actual
types.bug.required_body_sections.3=suspected_cause
types.bug.required_body_sections.4=regression_test
types.bug.required_body_sections.5=architecture_notes
types.tech.required_body_sections.0=goal
types.tech.required_body_sections.1=approach
types.tech.required_body_sections.2=verification
types.spike.required_body_sections.0=question
types.spike.required_body_sections.1=time_budget
types.spike.required_body_sections.2=approach
types.note.required_body_sections=[]
effort.allowed.0=S
effort.allowed.1=M
effort.allowed.2=L
effort.allowed.3=XL
effort.pickable_allowed.0=S
effort.pickable_allowed.1=M
claim.stale_after=24h
milestones.strategy=auto
milestones.trackers.planned_active_folder=milestone
milestones.trackers.shipped_folder=done
projects.enabled=false
commits.new=ticket: new {id} {title}
commits.capture=ticket: capture {id} {title}
commits.capture_update=ticket: capture-update {id}
commits.refine=ticket: refine {id} {title}
commits.claim=ticket: claim {id} {title}
commits.abandon=ticket: abandon {id} {title}
commits.update=ticket: update {id} {title}
commits.review=ticket: review {id} {title}
commits.reject=ticket: reject {id} {title}
commits.done=ticket: done {id} {title}
commits.fold=ticket: fold {id} into {target_id}
commits.wontfix=ticket: wontfix {id} {title}
commits.milestone_flip=milestone: {status} {version} — {reason}
research.agents.0.name=perf-expert
research.agents.0.consult=the work could affect latency, memory, or throughput
research.agents.1.name=language-expert
research.agents.1.consult=language-level design questions or idioms
review.agents.0=code-reviewer
review.agents.1=test-adequacy-reviewer
references.architecture=null
references.conventions=null
references.roadmap=null
references.template=docs/project/TICKET_TEMPLATE.md
references.project_readme=null
verification.test_commands=[]
verification.build_command=null
verification.pre_close_command=null
verification.max_loop_rounds=3
# --- resolved defaults ---
git.branch_workflow=enabled
git.branch_prefix=ticket/
git.merge_strategy=merge
git.pr_integration=none
# --- roles -> stage ---
roles.inbox=inbox
roles.pickable=backlog
roles.in_progress=in-progress
roles.review=in-review
roles.terminal=done
--- exit: 0
