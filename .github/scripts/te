#!/usr/bin/env bash
# te — ticket-engine CLI. The deterministic half of ticket-engine/SKILL.md,
# extracted so validation, parsing, and (later) reads are testable code rather
# than prose re-applied by a language model on every /ticket:* invocation.
#
# Design (TE-001):
#   - bash 3.2 + POSIX/BSD awk only. No gawk-isms, no bash 4+, no dependencies.
#   - Awk programs live in lib/*.awk, invoked `awk -f` — never heredocs.
#   - Output: flat key=value on stdout; multi-line values follow a ---BODY---
#     sentinel (used by the read path in TE-003). Exit 0 ok / 1 validation
#     failure / 2 internal error.
#   - The bundle dir is derived from this script's own path, so the .claude and
#     .github copies are byte-identical (the sync gate's directory-pair check
#     needs no normalization for them).
#   - Every subcommand accepts --dry-run; read subcommands ignore it. Each
#     declares its working-tree discipline in --help. This slate is read-only:
#     no subcommand touches the working tree.
#
# NOTE ON THE EXEC BIT: if this file itself lacks +x, the shell returns 126
# ("permission denied") before a single line here runs — te cannot report on its
# own missing exec bit. Callers (ticket-engine load_and_validate, /ticket:init
# step 7) MUST `[ -x <path>/te ]` before invoking and emit the pointed message.
# The test harness asserts the exec bit so a bad bundle copy fails loudly.

set -euo pipefail

# --- self / bundle detection (path-derived, so both copies are identical) ---
TE_SELF=$(cd "$(dirname "$0")" && pwd)
TE_BUNDLE=$(dirname "$TE_SELF")
TE_LIB="$TE_SELF/lib"
export TE_SELF TE_BUNDLE

if [ ! -r "$TE_LIB/common.sh" ]; then
  printf 'ok=false\nwhere=internal\nfailed=cannot read %s\nrecovery=the te bundle is incomplete; re-copy .claude/scripts (or .github/scripts) intact\n' \
    "$TE_LIB/common.sh" >&2
  exit 2
fi
# shellcheck source=lib/common.sh
. "$TE_LIB/common.sh"
if [ ! -r "$TE_LIB/helpers.sh" ]; then
  printf 'ok=false\nwhere=internal\nfailed=cannot read %s\nrecovery=the te bundle is incomplete; re-copy .claude/scripts (or .github/scripts) intact\n' \
    "$TE_LIB/helpers.sh" >&2
  exit 2
fi
# shellcheck source=lib/helpers.sh
. "$TE_LIB/helpers.sh"

DRY_RUN=0

usage() {
  cat <<EOF
te — ticket-engine CLI

Usage:
  te config validate [path] [--dry-run]   Validate config.yaml (§ Config, 18 rules);
                                          print resolved config + roles->stage map.
  te ledger validate [config] [--dry-run] Validate .ledger.yaml (filesystem backend).
  te slug "<title>" [--dry-run]           Kebab-case slug for a filename.
  te id next [--count N] [config]         Next filesystem ID(s), or NEW-k on github.
  te deps check <id> --depends-on <ids> [--slate <ids>] [config]
                                          Cycle + existence check (filesystem).
  te effort-cap --effort <e> --role <r> [config]   Enforce § Effort caps.
  te validate-body --type <t> --file <p> [config]  Check required body sections.
  te msg <event> --id <id> --title <t> [--target-id <id>] [--status <s>]
         [--version <v>] [--reason <r>] [config]    Render a commit/comment message.
  te --help                               This message.

Working-tree discipline: every subcommand in this build is READ-ONLY — none
touches the working tree. --dry-run is accepted everywhere and ignored by reads.

Exit codes: 0 ok · 1 validation/parse/not-found failure · 2 internal error.
EOF
}

# Strip --dry-run from the argument list (accepted everywhere, ignored by reads).
strip_flags() {
  local a
  ARGS=()
  for a in "$@"; do
    case "$a" in
      --dry-run) DRY_RUN=1 ;;
      *) ARGS+=("$a") ;;
    esac
  done
}

# Load the resolved config into $TE_TMPD/resolved for a config-reading
# subcommand. On failure, print the failure shape (captured while resolving) and
# return 1 so the caller exits 1.
load_config() {
  if ! resolve_config "${1:-}" >"$TE_TMPD/resolved"; then
    cat "$TE_TMPD/resolved"
    return 1
  fi
}

cmd_config_validate() {
  resolve_config "${1:-}"   # prints resolved config or the failure shape; sets rc
}

main() {
  if [ "$#" -eq 0 ]; then usage >&2; exit 2; fi
  case "$1" in
    -h|--help) usage; exit 0 ;;
  esac

  TE_TMPD=$(mktemp -d) || te_internal "mktemp failed"
  trap 'rm -rf "$TE_TMPD"' EXIT

  local group="$1"; shift
  case "$group" in
    config)
      local sub="${1:-}"; shift || true
      case "$sub" in
        validate) strip_flags "$@"; cmd_config_validate "${ARGS[0]:-}" || exit 1 ;;
        *) printf 'te: unknown config subcommand: %s\n' "${sub:-<none>}" >&2; usage >&2; exit 2 ;;
      esac
      ;;
    ledger)
      local sub="${1:-}"; shift || true
      case "$sub" in
        validate) strip_flags "$@"; cmd_ledger_validate "${ARGS[0]:-}" || exit 1 ;;
        *) printf 'te: unknown ledger subcommand: %s\n' "${sub:-<none>}" >&2; usage >&2; exit 2 ;;
      esac
      ;;
    slug)        strip_flags "$@"; cmd_slug "${ARGS[0]:-}" || exit 1 ;;
    id)
      local sub="${1:-}"; shift || true
      case "$sub" in
        next) cmd_id_next "$@" || exit 1 ;;
        *) printf 'te: unknown id subcommand: %s\n' "${sub:-<none>}" >&2; usage >&2; exit 2 ;;
      esac
      ;;
    deps)
      local sub="${1:-}"; shift || true
      case "$sub" in
        check) cmd_deps_check "$@" || exit 1 ;;
        *) printf 'te: unknown deps subcommand: %s\n' "${sub:-<none>}" >&2; usage >&2; exit 2 ;;
      esac
      ;;
    effort-cap)    cmd_effort_cap "$@" || exit 1 ;;
    validate-body) cmd_validate_body "$@" || exit 1 ;;
    msg)           cmd_msg "$@" || exit 1 ;;
    *) printf 'te: unknown subcommand: %s\n' "$group" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
